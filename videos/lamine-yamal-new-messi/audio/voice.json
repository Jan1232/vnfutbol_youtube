      "textSha256": "c765296da3e8b3f25967409ad646720e4250666c1d22f90d09f63f7cbeeee670",
      "settingsSha256": "31b37eb41084bb4596c6e40b86cabcc7d48ee02f5a9790c19c0b580510f57eee",
      "provider": {
        "model": "speech-2.8-hd",
        "voiceId": "Russian_Articulate_Tutor_v1"
      },
      "delivery": {}
    },
    {
      "id": "voice-030",
      "script": "SCRIPT-029",
      "type": "narration",
      "text": "Он уже игрок масштаба Месси по вниманию мира. Но место рядом с настоящей легендой ещё нужно заслужить годами, а не одним финалом.",
      "pauseAfter": 180,
