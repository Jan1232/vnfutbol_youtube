    {
      "id": "voice-018",
      "script": "SCRIPT-018",
      "type": "narration",
      "text": "Потом чемпионат мира 2026. Гол Саудовской Аравии. Финал против Аргентины. Испания побеждает один-ноль в дополнительное время. Чемпион мира в девятнадцать.",
      "pauseAfter": 260,
