      },
      "delivery": {}
    },
    {
      "id": "voice-007",
      "script": "SCRIPT-007",
      "type": "narration",
      "text": "Для обычного таланта такого набора хватило бы на целую карьеру. У Ямаля это всё ещё только начало биографии.",
      "pauseAfter": 180,
