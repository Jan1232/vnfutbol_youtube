    {
      "id": "voice-009",
      "script": "SCRIPT-009",
      "type": "narration",
      "text": "Он вырос в районе Rocafonda города Матаро. После голов показывает пальцами почтовый индекс своего района. Это не жест для камеры. Это память о том, откуда он пришёл.",
      "pauseAfter": 180,
