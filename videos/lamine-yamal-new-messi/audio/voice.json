      },
      "delivery": {}
    },
    {
      "id": "voice-022",
      "script": "SCRIPT-021",
      "type": "narration",
      "text": "Оба — воспитанники La Masia. Оба левоногие. Оба умеют начинать справа и уходить в центр. Оба очень рано стали центральными фигурами Barcelona.",
      "pauseAfter": 180,
      "scene": null,
