      },
      "delivery": {}
    },
    {
      "id": "voice-008",
      "script": "SCRIPT-008",
      "type": "narration",
      "text": "До того как весь мир узнал номер десять, для Ямаля важнее были другие три цифры — триста четыре.",
      "pauseAfter": 180,
      "scene": null,
      "status": "pending",
