      "settingsSha256": "31b37eb41084bb4596c6e40b86cabcc7d48ee02f5a9790c19c0b580510f57eee",
      "provider": {
        "model": "speech-2.8-hd",
        "voiceId": "Russian_Articulate_Tutor_v1"
      },
      "delivery": {},
      "position": "middle"
    },
    {
      "id": "voice-021",
      "script": "SCRIPT-020",
      "type": "narration",
      "text": "Но сравнение с Месси нельзя оставлять на уровне эмоций. Нужна честная метрика.",
