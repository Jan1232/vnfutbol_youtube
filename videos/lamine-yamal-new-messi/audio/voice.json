    {
      "id": "voice-014",
      "script": "SCRIPT-014",
      "type": "narration",
      "text": "Самый молодой игрок финальной стадии EURO. Самый молодой автор гола в истории турнира. Семь матчей, один гол, четыре ассиста. Испания — чемпион Европы. Ямалю в финале было семнадцать лет и один день.",
      "pauseAfter": 180,
      "scene": null,
      "status": "pending",
