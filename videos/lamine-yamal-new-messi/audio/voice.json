    },
    {
      "id": "voice-013",
      "script": "SCRIPT-013",
      "type": "narration",
      "text": "А дальше начался EURO 2024 — турнир, после которого сравнение с легендами перестало быть шуткой комментаторов.",
      "pauseAfter": 260,
      "scene": null,
      "status": "pending",
      "audio": null,
      "durationMs": null,
      "characters": 110,
